# LLM provider API keys. Users can also paste keys into the Streamlit UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Runtime environment.
APP_ENV=development
SURVEY_GENERATOR_TEMP_ROOT=/tmp/survey_generator
SURVEY_GENERATOR_PROJECT_STORE=/tmp/survey_generator_project_store
FILE_RETENTION_HOURS=24
MAX_UPLOAD_MB=25
MAX_TOTAL_UPLOAD_MB=100

# Optional OCR support for scanned PDFs. Requires pdf2image, pytesseract, and system OCR dependencies.
PHASE1_ENABLE_OCR=0

# Optional auth. Use "none" for local dev, "password" for simple app-level auth, or "proxy" behind SSO/reverse proxy.
SURVEY_GENERATOR_AUTH_MODE=none
SURVEY_GENERATOR_PASSWORD=
SURVEY_GENERATOR_PASSWORD_SHA256=
SURVEY_GENERATOR_USERS=
SURVEY_GENERATOR_AUTH_TOKEN=
SURVEY_GENERATOR_DEFAULT_USER=analyst
SURVEY_GENERATOR_PROXY_USER_ENV=REMOTE_USER

# Optional generic cost estimation. Set model-specific rates per million tokens if desired.
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=
